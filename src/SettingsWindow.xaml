          </Grid>
        </StackPanel>

        <!-- ================= system ================= -->
        <Grid x:Name="PageSys" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="МОДЕЛЬ РАСПОЗНАВАНИЯ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Быстрая (Whisper small, 244 МБ, около 0.8 ГБ памяти): хорошо в тишине, когда играет музыка, ошибается чаще. Точная (Whisper large-v3 turbo, 0.8 ГБ на видеокарте и процессоре, 1.6 ГБ для NPU; 1.3-2 ГБ памяти): почти без ошибок в тишине и заметно точнее, когда играет негромкая музыка; при громкой музыке ошибаются обе. Замер на MSI Claw 8 AI+, 16 с речи: быстрая 0.35 с на NPU, 0.8 с на видеокарте, 2.3 с на процессоре; точная 1.6 с на NPU, 0.5 с на видеокарте, 9.5 с на процессоре. Ошибок в тишине и когда играет музыка средней громкости: быстрая 7% и 21%, точная 0% и 4%. Обе модели работают на NPU, видеокарте и процессоре; точная на NPU в первый раз готовится около 6 минут, пока работает быстрая. Авто: точная на видеокарте без NPU, иначе быстрая. Нужной модели нет: она скачается."/>
            </StackPanel>
            <Border Style="{StaticResource SegBox}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="SttAuto" Content="Авто" GroupName="stt" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="SttSmall" Content="Быстрая" GroupName="stt" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="SttTurbo" Content="Точная" GroupName="stt" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ГДЕ РАСПОЗНАВАТЬ РЕЧЬ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="NPU: экономно, видеокарта остаётся играм. Видеокарта: быстрее всего, но делит её с играми. Процессор: работает на любом ПК, медленнее и нагружает ядра, пока идёт распознавание. Авто: NPU, если он есть, иначе видеокарта, иначе процессор. Смена перезапускает диктовку."/>
            </StackPanel>
