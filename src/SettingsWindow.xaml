                  <RadioButton x:Name="LlmDevNpu" Content="NPU" GroupName="llmdev" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="LlmDevGpu" Content="Видеокарта" GroupName="llmdev" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="LlmDevCpu" Content="Процессор" GroupName="llmdev" Style="{StaticResource Seg}"/>
                </UniformGrid>
              </Border>
              <TextBlock x:Name="GemmaState" FontSize="12" TextWrapping="Wrap" Margin="4,10,0,0"/>
