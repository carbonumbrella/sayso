            <TextBlock Text="ЧТО МОЖНО СКАЗАТЬ" Style="{StaticResource Label}"/>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="16,12">
              <TextBlock TextWrapping="Wrap" LineHeight="22">
                <Run Text="«Скриншот в телеграм»"/><LineBreak/>
                <Run Text="«Напиши в телеграм купить хлеб»"/><LineBreak/>
                <Run Text="«Отправь последнее фото» или «отправь скачанный файл»"/><LineBreak/>
                <Run Text="«Найди файл отчёт», потом «отправь этот файл в телеграм»"/><LineBreak/>
                <Run Text="После ответа: «отправь это в телеграм»"/><LineBreak/>
                <Run Text="«Отправь список команд в телеграм»"/>
