<Window x:Class="ClawVoice.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClawVoice"
        Title="SaySo" Icon="app.ico" Width="900" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource Fg}">
  <Border Style="{StaticResource Frame}">
    <StackPanel Margin="22,16,22,20">
      <Grid x:Name="TitleBar" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="SaySo" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource Sub}" FontSize="12" Margin="12,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource Close}" ToolTip="Закрыть"/>
      </Grid>

      <!-- tabs: the Claw screen at 175% has little height, so one page at a time -->
      <Border Style="{StaticResource SegBox}" Margin="0,12,0,4">
        <UniformGrid x:Name="TabsGrid" Rows="1">
          <RadioButton x:Name="TabMain" Content="Основное" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0" IsChecked="True"/>
          <RadioButton x:Name="TabSys" Content="Распознавание" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
          <RadioButton x:Name="TabVoice" Content="Голос" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
          <RadioButton x:Name="TabModel" Content="Помощник" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
          <RadioButton x:Name="TabTg" Content="Телеграм" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
          <RadioButton x:Name="TabCmd" Content="Команды" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
          <RadioButton x:Name="TabPlug" Content="Плагины" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
          <RadioButton x:Name="TabMore" Content="Ещё" GroupName="tab" Style="{StaticResource Seg}" Padding="2,0"/>
        </UniformGrid>
      </Border>

      <!-- scrolls only when the screen is short (Claw in portrait); Responsive.cs sets its MaxHeight -->
      <ScrollViewer x:Name="PagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Style="{StaticResource Pages}">
      <Grid>
        <!-- ================= main ================= -->
        <Grid x:Name="PageMain">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <!-- dictation-only install: the assistant parts are greyed until a model is chosen on the "Модель" tab -->
            <Border x:Name="MinimalBanner" CornerRadius="14" Background="{DynamicResource Card}" Padding="14,10" Margin="0,14,0,0"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Установлена только диктовка" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Команды, имя помощника, ответы голосом, Телеграм и плагины выключены. Кнопка ниже включает их, языковая модель не обязательна."/>
                <Button x:Name="EnableAssistantBtn" Content="Включить помощника" Style="{StaticResource Flat}" Background="{DynamicResource Accent}" Foreground="White" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="AssistantOnNote" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="4,12,0,0"
                       Foreground="{DynamicResource Sub}">
              <Run Text="Помощник включён. Для свободного разговора можно подключить языковую модель на "/><Hyperlink x:Name="ToModelLink"
                Foreground="{DynamicResource Accent}"><Run Text="вкладке «Помощник»"/></Hyperlink><Run Text="."/>
            </TextBlock>
            <TextBlock Text="ВКЛЮЧЕНИЕ" Style="{StaticResource Label}"/>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4">
              <StackPanel>
                <Grid Margin="0,8">
                  <StackPanel Margin="0,0,56,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Диктовка и голосовые команды" FontWeight="SemiBold"/>
                      <local:HelpTip Text="Главный выключатель SaySo. Держите кнопку диктовки и говорите: текст появится у курсора. Кнопка команды: нажмите и скажите, что сделать. Выключено: модель распознавания выгружается."/>
                    </StackPanel>
                    <TextBlock x:Name="DictationSub" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="DictationSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}"/>
                <Grid x:Name="ListenRow" Margin="0,8">
                  <StackPanel Margin="0,0,56,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="ListenTitle" Text="Откликаться на имя" FontWeight="SemiBold"/>
                      <local:HelpTip Text="Помощник откликается на фразу, которая начинается с его имени: «Сэйсо, громкость сорок». Только от сети. Микрофон всё время открыт, около 1% процессора."/>
                    </StackPanel>
                    <TextBlock x:Name="ListenSub" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="ListenSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border x:Name="GemmaLine" Height="1" Background="{DynamicResource Border}"/>
                <Grid x:Name="GemmaRow" Margin="0,8">
                  <StackPanel Margin="0,0,56,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="GemmaTitle" Text="Модель загружена" FontWeight="SemiBold"/>
                      <local:HelpTip Text="Gemma 3 4B на этом ПК: свободные вопросы и необычные команды. Пока загружена, занимает около 3.8 ГБ памяти. Простые команды работают и без неё."/>
                    </StackPanel>
                    <TextBlock x:Name="GemmaSub" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="GemmaSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="ПРОЧЕЕ" Style="{StaticResource Label}"/>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4">
              <StackPanel>
                <StackPanel Margin="0,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Микрофон наготове" FontWeight="SemiBold"/>
                    <local:HelpTip Text="Пока микрофон открыт, запись начинается сразу и захватывает 0.4 с до нажатия, а в трее горит значок микрофона. Закрытый микрофон просыпается около секунды, и начало фразы может потеряться."/>
                  </StackPanel>
                  <Border Style="{StaticResource SegBox}" Margin="0,6,0,0">
                    <UniformGrid Rows="1">
                      <RadioButton x:Name="MicReadyAlways" Content="Всегда от сети" GroupName="micready" Style="{StaticResource Seg}"/>
                      <RadioButton x:Name="MicReadyLinger" Content="5 минут" GroupName="micready" Style="{StaticResource Seg}"/>
                      <RadioButton x:Name="MicReadyPress" Content="При нажатии" GroupName="micready" Style="{StaticResource Seg}"/>
                    </UniformGrid>
                  </Border>
                  <TextBlock x:Name="MicReadyHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Border}"/>
                <Grid Margin="0,8">
                  <StackPanel Margin="0,0,56,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Звуковой сигнал" FontWeight="SemiBold"/>
                      <local:HelpTip Text="Писк в начале и в конце записи и когда помощник ждёт следующую фразу. Карточка на экране показывает запись и без него."/>
                    </StackPanel>
                    <TextBlock Text="Писк при нажатии кнопки и в конце записи" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="BeepSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}"/>
                <Grid Margin="0,8">
                  <StackPanel Margin="0,0,56,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Журнал диктовки" FontWeight="SemiBold"/>
                      <local:HelpTip Text="dictate.log в папке программы: что распознано и выполнено, ошибки. Помогает разобраться, если что-то не сработало. Выключено: в файл пишутся только ошибки."/>
                    </StackPanel>
                    <TextBlock Text="Распознанный текст и события в dictate.log" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="LogSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}"/>
                <Grid Margin="0,8">
                  <StackPanel Margin="0,0,56,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Запускать вместе с Windows" FontWeight="SemiBold"/>
                      <local:HelpTip Text="SaySo запускается при входе в Windows вместе с диктовкой. Выключено: запуск с ярлыка."/>
                    </StackPanel>
                    <TextBlock Text="Помощник, диктовка и модель (если не выгружена)" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- the buttons row sits at the bottom, level with the bottom of the left card ("ПРОЧЕЕ"), apart from the
               switches above it; when this column is the taller one it simply follows them -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="СОЧЕТАНИЯ КЛАВИШ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Две кнопки: диктовку держат, команду нажимают. Одна кнопка: коротко нажать для команды, держать для диктовки. Работают поверх игр. На MSI Claw с ClawTweaks кнопка ниже назначит их на M1 (и M2)."/>
            </StackPanel>
            <!-- one key for both (tap = command, hold = dictation: dictate.py one_button) or a key each -->
            <Border x:Name="KeysModeBox" Style="{StaticResource SegBox}" Margin="0,0,0,8">
              <UniformGrid Rows="1">
                <RadioButton x:Name="KeysOne" Content="Одна кнопка" GroupName="keys" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="KeysTwo" Content="Две кнопки" GroupName="keys" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock x:Name="HotkeyDictLabel" Text="Диктовка" VerticalAlignment="Center"/>
              <Button x:Name="HotkeyDictation" Grid.Column="1" Style="{StaticResource Flat}" Focusable="True"
                      ToolTip="Нажмите и затем нужное сочетание. Esc: отмена"/>
              <TextBlock x:Name="HotkeyCmdLabel" Grid.Row="2" Text="Команда" VerticalAlignment="Center"/>
              <Button x:Name="HotkeyGemma" Grid.Row="2" Grid.Column="1" Style="{StaticResource Flat}" Focusable="True"
                      ToolTip="Нажмите и затем нужное сочетание. Esc: отмена"/>
            </Grid>
            <Grid Margin="0,6,0,0">
              <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,0,110,0"
                         Text="Диктовку держат, команду нажимают. Кнопку на корпусе назначьте на то же сочетание в её утилите."/>
              <Button x:Name="HotkeyReset" Content="По умолчанию" Style="{StaticResource Flat}" Height="30" FontSize="12"
                      HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <!-- MSI Claw back buttons in ClawTweaks (ClawButtonsPanel), only where ClawTweaks is installed -->
            <ContentControl x:Name="ClawButtonsHost"/>
            </StackPanel>
            <!-- "Подсветка" only where ClawAmbilight is installed (the Claw): elsewhere two buttons share the row -->
            <UniformGrid x:Name="MainButtons" Grid.Row="1" Rows="1" Margin="0,22,-8,0" VerticalAlignment="Bottom">
              <Button x:Name="CommandsBtn" Content="Что умеет" Style="{StaticResource Flat}" Margin="0,0,8,0"/>
              <Button x:Name="AmbiBtn" Content="Подсветка" Style="{StaticResource Flat}" Margin="0,0,8,0"/>
              <Button x:Name="LogBtn" Content="Журнал" Style="{StaticResource Flat}" Margin="0,0,8,0"/>
            </UniformGrid>
          </Grid>
        </Grid>

        <!-- ================= voice ================= -->
        <Grid x:Name="PageVoice" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel x:Name="VoiceSection">
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ГОЛОС ОТВЕТОВ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Голоса Windows, новые добавляются в Параметрах: «Время и язык», «Речь». Скорость и громкость меняют только голос помощника."/>
            </StackPanel>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4" Margin="0,0,0,12">
              <Grid Margin="0,8">
                <StackPanel Margin="0,0,56,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Отвечать голосом" FontWeight="SemiBold"/>
                    <local:HelpTip Text="Выключено: ответы только на карточке. Сигналы записи и таймера остаются. В «Полностью офлайн» без модели голоса нет всегда."/>
                  </StackPanel>
                  <TextBlock x:Name="SpeakHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="SpeakSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="VoiceBox" Style="{StaticResource Combo}"/>
              <Button x:Name="VoiceTestBtn" Grid.Column="2" Content="Послушать" Style="{StaticResource Flat}"/>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="Скорость" VerticalAlignment="Center"/>
              <Slider x:Name="RateSlider" Grid.Column="1" Minimum="-5" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"/>
              <TextBlock x:Name="RateText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="2" Text="Громкость" VerticalAlignment="Center"/>
              <Slider x:Name="VolumeSlider" Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
              <TextBlock x:Name="VolumeText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
          </StackPanel>
        </Grid>

        <!-- ================= model ================= -->
        <Grid x:Name="PageModel" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel x:Name="NameSection">
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ИМЯ ПОМОЩНИКА" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="На это слово откликается помощник, так он себя и называет. Лучше 2-3 слога, не похожие на частые слова. «Тренировать имя» учит распознавание вашему произношению."/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>
              <Button x:Name="NameBtn" Grid.Column="2" Content="Сохранить" Style="{StaticResource Flat}" Background="{DynamicResource Accent}" Foreground="White"/>
            </Grid>
            <Grid Margin="0,6,0,0">
              <TextBlock x:Name="NameHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,0,120,0"
                         Text="Зовите по имени в начале фразы: «Сэйсо, громкость сорок»."/>
              <Button x:Name="TrainBtn" Content="Тренировать имя" Style="{StaticResource Flat}" Height="30" FontSize="12"
                      HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ПОМОЩНИК И ЯЗЫКОВАЯ МОДЕЛЬ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Модель нужна для разговора и необычных команд, без неё работают команды из «Что умеет». Локально: Gemma на этом ПК, около 4 ГБ памяти. Свой сервер: Ollama, LM Studio. Облако: Gemini, нужен ключ."/>
            </StackPanel>
            <!-- what is saved and working now, apart from the choice below (which is only a draft until «Сохранить») -->
            <Border x:Name="ModelNowBox" CornerRadius="12" Padding="12,8" Margin="0,0,0,8" BorderThickness="1">
              <TextBlock x:Name="ModelNow" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource SegBox}">
              <Grid><!-- widths after the labels -->
                <Grid.ColumnDefinitions><ColumnDefinition Width="10*"/><ColumnDefinition Width="9*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
                <RadioButton x:Name="ProvNone" Grid.Column="0" Content="Без модели" GroupName="prov" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="ProvNpu" Grid.Column="1" Content="Локально" GroupName="prov" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="ProvServer" Grid.Column="2" Content="Свой сервер" GroupName="prov" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="ProvCloud" Grid.Column="3" Content="Облако" GroupName="prov" Style="{StaticResource Seg}"/>
              </Grid>
            </Border>
            <TextBlock x:Name="ProvHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
            <TextBlock Text="ИНТЕРНЕТ" Style="{StaticResource Label}"/>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4">
              <Grid Margin="0,8">
                <StackPanel Margin="0,0,56,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Полностью офлайн" FontWeight="SemiBold"/>
                    <local:HelpTip Text="Отключает погоду, поиск, Википедию, облако и свой сервер. Остаются диктовка, команды, плагины, Телеграм и Gemma на этом ПК. С «Без модели»: только команды, без голоса."/>
                  </StackPanel>
                  <TextBlock Text="Без погоды, поиска, Википедии, облака и своего сервера. Диктовка, команды и Телеграм работают" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="OfflineSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel x:Name="FollowLabel" Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="СЛУШАТЬ ПОСЛЕ ОТВЕТА" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Сколько секунд помощник ждёт следующую фразу без имени и кнопки. 0: не ждёт. Пока ждёт, музыка звучит тише."/>
            </StackPanel>
            <Grid x:Name="FollowRow">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
              <Slider x:Name="FollowSlider" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"/>
              <TextBlock x:Name="FollowText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <StackPanel x:Name="NpuFields" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
                <TextBlock Text="ГДЕ ЗАПУСКАТЬ GEMMA" Style="{StaticResource Label}" Margin="0"/>
                <local:HelpTip Text="NPU: экономно, видеокарта свободна для игр. Видеокарта: быстрее всего. Процессор: на любом ПК, но медленно. Около 4 ГБ памяти в любом случае."/>
              </StackPanel>
              <Border Style="{StaticResource SegBox}">
                <Grid><!-- widths after the labels -->
                  <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="11*"/><ColumnDefinition Width="10*"/></Grid.ColumnDefinitions>
                  <RadioButton x:Name="LlmDevAuto" Grid.Column="0" Content="Авто" GroupName="llmdev" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="LlmDevNpu" Grid.Column="1" Content="NPU" GroupName="llmdev" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="LlmDevGpu" Grid.Column="2" Content="Видеокарта" GroupName="llmdev" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="LlmDevCpu" Grid.Column="3" Content="Процессор" GroupName="llmdev" Style="{StaticResource Seg}"/>
                </Grid>
              </Border>
              <TextBlock x:Name="GemmaState" FontSize="12" TextWrapping="Wrap" Margin="4,10,0,0"/>
              <StackPanel x:Name="GemmaGet">
                <TextBlock Text="ТОКЕН HUGGING FACE (НЕ СОХРАНЯЕТСЯ)" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="HfTokenBox" Style="{StaticResource Secret}"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="GemmaHowBtn" Content="Как получить токен" Style="{StaticResource Flat}"/>
                  <Button x:Name="GemmaGetBtn" Grid.Column="2" Content="Скачать Gemma" Style="{StaticResource Flat}"/>
                </Grid>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ServerFields">
              <TextBlock Text="АДРЕС (OPENAI-СОВМЕСТИМЫЙ)" Style="{StaticResource Label}"/>
              <TextBox x:Name="UrlBox" Style="{StaticResource Field}"/>
              <TextBlock Text="МОДЕЛЬ" Style="{StaticResource Label}"/>
              <TextBox x:Name="ModelBox" Style="{StaticResource Field}"/>
              <TextBlock Text="КЛЮЧ API (ХРАНИТСЯ ЗАШИФРОВАННЫМ)" Style="{StaticResource Label}"/>
              <PasswordBox x:Name="KeyBox" Style="{StaticResource Secret}"/>
              <Button x:Name="GeminiKeyBtn" Content="Получить бесплатный ключ Gemini" Style="{StaticResource Flat}" Margin="0,8,0,0"/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ModelSaveBtn" Content="Сохранить" Style="{StaticResource Flat}" Background="{DynamicResource Accent}" Foreground="White"/>
              <Button x:Name="ModelTestBtn" Grid.Column="2" Content="Проверить" Style="{StaticResource Flat}"/>
            </Grid>
            <TextBlock x:Name="ModelStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
          </StackPanel>
        </Grid>

        <!-- ================= telegram ================= -->
        <Grid x:Name="PageTg" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
            <TextBlock Text="СВОЙ БОТ В ТЕЛЕГРАМЕ" Style="{StaticResource Label}" Margin="0"/>
            <local:HelpTip Text="Помощник присылает в ваш личный бот скриншоты, файлы и ответы: «отправь это в телеграм». Токен хранится зашифрованным."/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Sub}" FontSize="12" Margin="4,0,0,8"
                     Text="1. Создайте бота у @BotFather и скопируйте токен.  2. Вставьте токен ниже.  3. Впишите ID чата или напишите боту /start и нажмите «Привязать»."/>
          <TextBlock Text="ТОКЕН БОТА (ХРАНИТСЯ ЗАШИФРОВАННЫМ)" Style="{StaticResource Label}"/>
          <PasswordBox x:Name="TgTokenBox" Style="{StaticResource Secret}"/>
          <TextBlock Text="ID ЧАТА" Style="{StaticResource Label}"/>
          <TextBox x:Name="TgChatBox" Style="{StaticResource Field}"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="TgLinkBtn" Content="Привязать" Style="{StaticResource Flat}" Background="{DynamicResource Accent}" Foreground="White"/>
            <Button x:Name="TgTestBtn" Grid.Column="2" Content="Отправить проверку" Style="{StaticResource Flat}"/>
          </Grid>
          <TextBlock x:Name="TgStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
          </StackPanel>
          <!-- what the linked bot is for: the voice phrases that use it -->
          <StackPanel Grid.Column="2">
            <TextBlock Text="ЧТО МОЖНО СКАЗАТЬ" Style="{StaticResource Label}"/>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="16,12">
              <TextBlock TextWrapping="Wrap" LineHeight="22">
                <Run Text="«Скриншот в телеграм»"/><LineBreak/>
                <Run Text="«Напиши в телеграм купить хлеб»"/><LineBreak/>
                <Run Text="«Отправь последнее фото» или «отправь скачанный файл»"/><LineBreak/>
                <Run Text="«Найди файл отчёт», потом «отправь этот файл в телеграм»"/><LineBreak/>
                <Run Text="После ответа: «отправь это в телеграм»"/><LineBreak/>
                <Run Text="«Отправь список команд в телеграм»"/>
              </TextBlock>
            </Border>
            <TextBlock Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"
                       Text="Сообщения идут только в ваш чат с вашим ботом. Команды из Телеграма помощник не принимает."/>
          </StackPanel>
        </Grid>

        <!-- ================= commands ================= -->
        <Grid x:Name="PageCmd" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="МОИ КОМАНДЫ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Свои фразы и действия: сайт, программа, папка, сочетание клавиш, текст, webhook или PowerShell (с подтверждением). Срабатывают раньше встроенных. «*» ловит любой хвост: «найди в ютубе *»."/>
            </StackPanel>
            <ListBox x:Name="CmdList" Style="{StaticResource Rows}" Height="250"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="CmdNewBtn" Content="Новая" Style="{StaticResource Flat}"/>
              <Button x:Name="CmdDelBtn" Grid.Column="2" Content="Удалить" Style="{StaticResource Flat}"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ФРАЗЫ (ПО ОДНОЙ В СТРОКЕ, * = ЛЮБОЙ ХВОСТ)" Style="{StaticResource Label}"/>
            <TextBox x:Name="CmdSay" Style="{StaticResource Field}" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
            <TextBlock Text="ДЕЙСТВИЕ" Style="{StaticResource Label}"/>
            <ComboBox x:Name="CmdDo" Style="{StaticResource Combo}"/>
            <TextBlock x:Name="CmdArgLabel" Text="ПАРАМЕТР" Style="{StaticResource Label}"/>
            <Grid>
              <TextBox x:Name="CmdArg" Style="{StaticResource Field}"/>
              <!-- placeholder while the field is empty (set per action in code) -->
              <TextBlock x:Name="CmdArgHint" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Sub}" Visibility="Collapsed"/>
            </Grid>
            <TextBlock Text="ОТВЕТ ПОМОЩНИКА (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource Label}"/>
            <TextBox x:Name="CmdReply" Style="{StaticResource Field}"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="CmdSaveBtn" Content="Сохранить" Style="{StaticResource Flat}" Background="{DynamicResource Accent}" Foreground="White"/>
              <Button x:Name="CmdFolderBtn" Grid.Column="2" Content="Открыть файл" Style="{StaticResource Flat}"/>
            </Grid>
            <TextBlock Text="ПРОВЕРИТЬ ФРАЗУ" Style="{StaticResource Label}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="CmdTestBox" Style="{StaticResource Field}"/>
              <Button x:Name="CmdTestBtn" Grid.Column="2" Content="Проверить" Style="{StaticResource Flat}"/>
            </Grid>
            <TextBlock x:Name="CmdStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,6,0,0"/>
          </StackPanel>
        </Grid>

        <!-- ================= plugins ================= -->
        <StackPanel x:Name="PagePlug" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
            <TextBlock Text="ПЛАГИНЫ" Style="{StaticResource Label}" Margin="0"/>
            <local:HelpTip Text="Команды для отдельных программ, например ClawAmbilight или ClawTweaks. Плагин без своей программы молчит, выключенный не загружается."/>
          </StackPanel>
          <ListBox x:Name="PlugList" Style="{StaticResource Rows}" Height="300"/>
          <Grid Margin="0,10,0,0">
            <TextBlock Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,0,200,0" VerticalAlignment="Center"
                       Text="Свой плагин: Python-файл с функцией register(api) в папке плагинов. Изменения подхватываются сами."/>
            <Button x:Name="PlugFolderBtn" Content="Открыть папку плагинов" Style="{StaticResource Flat}" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>

        <!-- ================= system ================= -->
        <Grid x:Name="PageSys" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="МОДЕЛЬ РАСПОЗНАВАНИЯ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Быстрая: Whisper small, меньше памяти, под музыку ошибается чаще. Точная: Whisper turbo, почти без ошибок, на NPU в первый раз готовится около 6 минут. Замеры в инструкции."/>
            </StackPanel>
            <Border Style="{StaticResource SegBox}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="SttAuto" Content="Авто" GroupName="stt" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="SttSmall" Content="Быстрая" GroupName="stt" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="SttTurbo" Content="Точная" GroupName="stt" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ГДЕ РАСПОЗНАВАТЬ РЕЧЬ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="NPU: экономно, видеокарта свободна для игр. Видеокарта: быстрее всего. Процессор: на любом ПК, но медленнее. Смена перезапускает диктовку."/>
            </StackPanel>
            <Border Style="{StaticResource SegBox}">
              <Grid><!-- widths after the labels -->
                <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="11*"/><ColumnDefinition Width="10*"/></Grid.ColumnDefinitions>
                <RadioButton x:Name="DevAuto" Grid.Column="0" Content="Авто" GroupName="dev" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="DevNpu" Grid.Column="1" Content="NPU" GroupName="dev" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="DevGpu" Grid.Column="2" Content="Видеокарта" GroupName="dev" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="DevCpu" Grid.Column="3" Content="Процессор" GroupName="dev" Style="{StaticResource Seg}"/>
              </Grid>
            </Border>
            <TextBlock x:Name="HwText" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0" Text="Определяю железо…"/>
            <TextBlock x:Name="SysStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
            <!-- a size or device whose model is not downloaded: asked here instead of a silent fallback (SwitchStt) -->
            <StackPanel x:Name="SttAsk" Visibility="Collapsed" Margin="4,10,0,0">
              <TextBlock x:Name="SttAskText" FontSize="12" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SttAskGet" Content="Скачать и переключить" Style="{StaticResource Flat}" Height="30" FontSize="12" Padding="14,0"/>
                <Button x:Name="SttAskCancel" Content="Отмена" Style="{StaticResource Flat}" Height="30" FontSize="12" Padding="14,0" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ЯЗЫК" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Язык распознавания и ответов. «Авто» определяет язык каждой фразы, на коротких фразах иногда ошибается."/>
            </StackPanel>
            <Border Style="{StaticResource SegBox}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="LangRu" Content="Русский" GroupName="lang" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="LangEn" Content="English" GroupName="lang" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="LangAuto" Content="Авто" GroupName="lang" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
            <TextBlock Text="МИКРОФОН" Style="{StaticResource Label}" ToolTip="«По умолчанию» берёт микрофон, выбранный в Windows"/>
            <ComboBox x:Name="MicBox" Style="{StaticResource Combo}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="СКАЧАННЫЕ МОДЕЛИ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Модели можно скачать и удалить. Ту, что сейчас распознаёт речь, удалить нельзя: сначала выберите другую. Gemma скачивается на вкладке «Помощник»."/>
            </StackPanel>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4">
              <StackPanel x:Name="ModelRows"/>
            </Border>
            <TextBlock x:Name="ModelsStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ОБРАБОТКА МИКРОФОНА" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Аппаратная: шум и музыку убирает драйвер микрофона, если умеет (Intel Smart Sound на MSI Claw), под музыку ошибок меньше. Обычная: звук как есть, для внешних микрофонов и гарнитур."/>
            </StackPanel>
            <Border Style="{StaticResource SegBox}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="MicProcHw" Content="Аппаратная" GroupName="micproc" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="MicProcOff" Content="Обычная" GroupName="micproc" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
            <Grid Margin="0,6,0,0">
              <TextBlock x:Name="MicProcHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,0,150,0"
                         Text="Аппаратная работает, если драйвер это умеет, иначе как обычная."/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MicFxBtn" Content="Звук в Windows" Style="{StaticResource Flat}" Height="30" FontSize="12"/>
                <local:HelpTip Text="Открывает свойства микрофона в Windows. Для диктовки оставьте «Эффекты устройства по умолчанию»: Voice Clarity сделан для звонков, а без улучшения остаются шумы. Если после смены звук пропал, верните «По умолчанию» или перезагрузите компьютер."/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="VoiceHint" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,10,0,0"
                       Text="Язык и микрофон применяются после перезапуска диктовки, это делается само."/>
          </StackPanel>
        </Grid>

        <!-- ================= more: program folders, data, about ================= -->
        <Grid x:Name="PageMore" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="ПАПКИ С ПРОГРАММАМИ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="«Открой …» знает программы из меню «Пуск». Добавьте папку с портативными программами или играми, и помощник найдёт их по имени."/>
            </StackPanel>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4">
              <StackPanel x:Name="AppFolderRows"/>
            </Border>
            <Button x:Name="AddAppFolderBtn" Content="Добавить папку" Style="{StaticResource Flat}" Margin="0,8,0,0"/>
            <TextBlock x:Name="AppFoldersStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
            <TextBlock Text="ГОРОД ДЛЯ ПОГОДЫ" Style="{StaticResource Label}" ToolTip="Для ответов о погоде. Хранится только на этом ПК, можно сказать и голосом: «мой город Москва»"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="CityBox" Style="{StaticResource Field}"/>
              <Button x:Name="CityBtn" Grid.Column="2" Content="Сохранить" Style="{StaticResource Flat}" Background="{DynamicResource Accent}" Foreground="White"/>
            </Grid>
            <TextBlock x:Name="CityNow" Foreground="{DynamicResource Sub}" FontSize="12" Margin="4,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ДАННЫЕ" Style="{StaticResource Label}" ToolTip="Экспорт сохраняет настройки, имя, команды и плагины в zip на рабочий стол, без токенов и ключей"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ExportBtn" Content="Экспорт настроек" Style="{StaticResource Flat}"/>
              <Button x:Name="ImportBtn" Grid.Column="2" Content="Импорт" Style="{StaticResource Flat}"/>
            </Grid>
            <Button x:Name="DiagBtn" Content="Собрать отчёт для диагностики" Style="{StaticResource Flat}" Margin="0,8,0,0"
                    ToolTip="Журналы, настройки и сведения о железе в zip на рабочий стол, без токенов и ключей"/>
            <TextBlock x:Name="MoreStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
              <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource Label}" Margin="0"/>
              <local:HelpTip Text="Проверяет последний выпуск на GitHub. Новую версию запустите поверх старой, настройки и модели сохранятся. Без вас SaySo ничего не скачивает."/>
            </StackPanel>
            <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,10">
              <StackPanel>
                <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                <TextBlock Text="Голосовой помощник и диктовка для Windows. Открытый код, лицензия MIT." Foreground="{DynamicResource Sub}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
            <Button x:Name="UpdateBtn" Content="Проверить обновления" Style="{StaticResource Flat}" Margin="0,8,0,0"/>
            <Button x:Name="UpdateGetBtn" Content="Скачать новую версию" Style="{StaticResource Flat}" Margin="0,8,0,0"
                    Background="{DynamicResource Accent}" Foreground="White" Visibility="Collapsed"/>
            <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0"/>
            <UniformGrid Rows="1" Margin="0,8,-8,0">
              <Button x:Name="RepoBtn" Content="Страница на GitHub" Style="{StaticResource Flat}" Margin="0,0,8,0"/>
              <Button x:Name="GuideBtn" Content="Инструкция" Style="{StaticResource Flat}" Margin="0,0,8,0"/>
            </UniformGrid>
          </StackPanel>
        </Grid>
      </Grid>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
