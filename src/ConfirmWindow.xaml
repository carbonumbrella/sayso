<Window x:Class="ClawVoice.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Fg}" Opacity="0">
  <Border Style="{StaticResource Frame}" Margin="24" Width="520">
    <StackPanel Margin="28,26,28,24">
      <StackPanel Orientation="Horizontal">
        <Grid Width="40" Height="40">
          <Border x:Name="IconBg" CornerRadius="20" Opacity="0.15"/>
          <TextBlock x:Name="Icon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="400"/>
      </StackPanel>
      <TextBlock x:Name="Msg" FontSize="15" Foreground="{DynamicResource Sub}" Margin="0,16,0,0" TextWrapping="Wrap"/>
      <Border x:Name="DetailBox" CornerRadius="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" Margin="0,14,0,0" Padding="14,10">
        <TextBlock x:Name="Detail" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap"/>
      </Border>
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="NoBtn" Style="{StaticResource Flat}" Height="48" FontSize="15"/>
        <Button x:Name="YesBtn" Grid.Column="2" Style="{StaticResource Flat}" Height="48" FontSize="15" Foreground="White"/>
      </Grid>
      <Border Height="3" CornerRadius="2" Background="{DynamicResource Ghost}" Margin="0,18,0,0">
        <Border x:Name="Bar" Height="3" CornerRadius="2" HorizontalAlignment="Left"/>
      </Border>
      <TextBlock x:Name="Hint" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
  </Border>
</Window>
